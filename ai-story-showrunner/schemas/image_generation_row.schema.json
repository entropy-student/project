{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://entropy-student.local/ai-story-showrunner/image-generation-row.schema.json",
  "title": "AI Story Showrunner Image Generation Row",
  "type": "object",
  "required": [
    "image_id",
    "visual_beat_id",
    "semantic_shot_id",
    "prompt",
    "negative_constraints",
    "character_refs",
    "scene_refs",
    "prop_ui_refs",
    "style_refs",
    "continuity_ref",
    "shot_size",
    "pov",
    "aspect_ratio",
    "resolution",
    "output_name",
    "acceptance_criteria"
  ],
  "properties": {
    "image_id": {
      "type": "string",
      "minLength": 1
    },
    "visual_beat_id": {
      "type": "string",
      "minLength": 1
    },
    "semantic_shot_id": {
      "type": "string",
      "minLength": 1
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "negative_constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "character_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scene_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prop_ui_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "style_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "continuity_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "shot_size": {
      "type": "string",
      "minLength": 1
    },
    "pov": {
      "type": "string",
      "minLength": 1
    },
    "aspect_ratio": {
      "type": "string",
      "minLength": 1
    },
    "resolution": {
      "type": "string",
      "minLength": 1
    },
    "text_render_mode": {
      "type": "string",
      "enum": [
        "IMAGE_NATIVE",
        "POST_OVERLAY",
        "NONE"
      ]
    },
    "output_name": {
      "type": "string",
      "minLength": 1
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
