{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://entropy-student.local/ai-story-showrunner/semantic-shot.schema.json",
  "title": "AI Story Showrunner Semantic Shot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "semantic_shot_id",
    "narration_span",
    "story_function",
    "visual_state",
    "character_ids",
    "scene_id",
    "action",
    "expression",
    "composition",
    "camera_angle",
    "image_intent",
    "continuity_role",
    "transition_intent",
    "visual_forbidden",
    "acceptance_criteria"
  ],
  "properties": {
    "semantic_shot_id": {"type":"string","minLength":1},
    "narration_span": {"type":"string","minLength":1},
    "story_function": {"type":"string","minLength":1},
    "visual_state": {"type":"string","minLength":1},
    "character_ids": {"type":"array","items":{"type":"string"}},
    "scene_id": {"type":["string","null"]},
    "action": {"type":"string","minLength":1},
    "expression": {"type":["string","null"]},
    "composition": {"type":"string","minLength":1},
    "camera_angle": {"type":"string","minLength":1},
    "image_intent": {"type":"string","minLength":1},
    "continuity_role": {"type":"string","enum":["ESTABLISH","CONTINUE","REACTION","REVERSAL","INSERT","METAPHOR","PAYOFF","TRANSITION"]},
    "transition_intent": {"type":"string","enum":["CUT","DISSOLVE","HOLD","MATCH_CUT","NONE"]},
    "subtitle_intent": {"type":["string","null"]},
    "visual_forbidden": {"type":"array","items":{"type":"string"}},
    "acceptance_criteria": {"type":"array","minItems":1,"items":{"type":"string"}},
    "planning_duration_hint_sec": {"type":["number","null"],"exclusiveMinimum":0},
    "notes": {"type":["string","null"]}
  }
}