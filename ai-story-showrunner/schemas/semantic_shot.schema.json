{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://entropy-student.local/ai-story-showrunner/semantic-shot.schema.json",
  "title": "AI Story Showrunner Semantic Shot v0.3",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "semantic_shot_id",
    "sequence_id",
    "scene_id",
    "narration_span",
    "dramatic_refs",
    "visual_intention",
    "shot_function_primary",
    "subject_priority",
    "staging_blocking",
    "framing_strategy",
    "pov_strategy",
    "composition_strategy",
    "eye_trace_in",
    "eye_trace_out",
    "visual_intensity",
    "image_relation_grammar",
    "visual_state",
    "acceptance_criteria"
  ],
  "properties": {
    "semantic_shot_id": {
      "type": "string",
      "minLength": 1
    },
    "sequence_id": {
      "type": "string",
      "minLength": 1
    },
    "scene_id": {
      "type": "string",
      "minLength": 1
    },
    "narration_span": {
      "type": "string",
      "minLength": 1
    },
    "dramatic_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "visual_intention": {
      "type": "object",
      "required": [
        "primary"
      ],
      "properties": {
        "primary": {
          "type": "string",
          "minLength": 1
        },
        "secondary": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "shot_function_primary": {
      "type": "string",
      "minLength": 1
    },
    "subject_priority": {
      "type": "string",
      "minLength": 1
    },
    "staging_blocking": {
      "type": "string",
      "minLength": 1
    },
    "framing_strategy": {
      "type": "string",
      "minLength": 1
    },
    "pov_strategy": {
      "type": "string",
      "minLength": 1
    },
    "composition_strategy": {
      "type": "string",
      "minLength": 1
    },
    "eye_trace_in": {
      "type": "string",
      "minLength": 1
    },
    "eye_trace_out": {
      "type": "string",
      "minLength": 1
    },
    "screen_direction": {
      "type": [
        "string",
        "null"
      ]
    },
    "visual_intensity": {
      "type": "string",
      "minLength": 1
    },
    "image_relation_grammar": {
      "type": "string",
      "minLength": 1
    },
    "visual_state": {
      "type": "string",
      "minLength": 1
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
