{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://entropy-student.local/ai-story-showrunner/visual-beat.schema.json",
  "title": "AI Story Showrunner Visual Beat Shotbook Row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "visual_beat_id",
    "semantic_shot_id",
    "start",
    "end",
    "duration",
    "timing_source",
    "narration_fragment",
    "character_ids",
    "scene_id",
    "visual_state",
    "visual_delta",
    "image_intent",
    "composition_hint",
    "camera_angle_hint",
    "continuity_role",
    "transition_intent",
    "visual_forbidden",
    "acceptance_criteria"
  ],
  "properties": {
    "visual_beat_id": {"type":"string","minLength":1},
    "semantic_shot_id": {"type":"string","minLength":1},
    "phase": {"type":"string","enum":["SINGLE","SETUP","PROGRESSION","RESULT_OR_REACTION"]},
    "start": {"type":"number","minimum":0},
    "end": {"type":"number","exclusiveMinimum":0},
    "duration": {"type":"number","exclusiveMinimum":0},
    "timing_source": {"type":"string","enum":["JINGSUI_CALIBRATED_REFERENCE","AUDIO_LOCKED"]},
    "narration_fragment": {"type":"string"},
    "character_ids": {"type":"array","items":{"type":"string"}},
    "scene_id": {"type":["string","null"]},
    "action_hint": {"type":["string","null"]},
    "expression_hint": {"type":["string","null"]},
    "visual_state": {"type":"string","minLength":1},
    "visual_delta": {"type":"string","minLength":1},
    "image_intent": {"type":"string","minLength":1},
    "composition_hint": {"type":"string","minLength":1},
    "camera_angle_hint": {"type":"string","minLength":1},
    "continuity_role": {"type":"string","enum":["ESTABLISH","CONTINUE","REACTION","REVERSAL","INSERT","METAPHOR","PAYOFF","TRANSITION"]},
    "transition_intent": {"type":"string","enum":["CUT","DISSOLVE","HOLD","MATCH_CUT","NONE"]},
    "visual_forbidden": {"type":"array","items":{"type":"string"}},
    "acceptance_criteria": {"type":"array","minItems":1,"items":{"type":"string"}},
    "notes": {"type":["string","null"]}
  }
}