{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://entropy-student.local/ai-story-showrunner/frame-execution-row.schema.json",
  "title": "AI Story Showrunner Frame Execution Row v0.2",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "visual_beat_id",
    "frame_blueprint_ref",
    "execution_mode",
    "asset_binding",
    "output_name",
    "acceptance_criteria"
  ],
  "properties": {
    "visual_beat_id": {
      "type": "string",
      "minLength": 1
    },
    "frame_blueprint_ref": {
      "type": "string",
      "minLength": 1
    },
    "execution_mode": {
      "type": "string",
      "enum": [
        "GENERATE",
        "DERIVE_EDIT",
        "COMPOSITE_CROP"
      ]
    },
    "asset_binding": {
      "type": "object",
      "required": [
        "character_refs",
        "scene_refs",
        "prop_ui_refs",
        "style_refs"
      ],
      "properties": {
        "character_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scene_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "prop_ui_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "style_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "source_frame_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_asset_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prompt": {
      "type": [
        "string",
        "null"
      ]
    },
    "edit_delta": {
      "type": [
        "string",
        "null"
      ]
    },
    "composite_instructions": {
      "type": [
        "string",
        "null"
      ]
    },
    "negative_constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "text_render_mode": {
      "type": "string",
      "enum": [
        "NONE",
        "POST_OVERLAY",
        "IMAGE_NATIVE"
      ]
    },
    "aspect_ratio": {
      "type": "string"
    },
    "resolution": {
      "type": "string"
    },
    "output_name": {
      "type": "string",
      "minLength": 1
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
