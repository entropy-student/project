index 62de684..2a441a4 100644
--- a/app/Http/Middleware/SetAdminLocale.php
+++ b/app/Http/Middleware/SetAdminLocale.php
@@ -11,7 +11,22 @@ class SetAdminLocale
 {
     public function handle(Request $request, Closure $next): Response
     {
-        App::setLocale('zh_CN');
+        $allowedLocales = config('settings.allowed_languages', []);
+        $locale = $request->session()->get('locale');
+
+        if (! is_array($allowedLocales)) {
+            $allowedLocales = [];
+        }
+
+        if (! is_string($locale) || $locale === '' || ! in_array($locale, $allowedLocales, true)) {
+            $locale = config('app.locale', 'en');
+        }
+
+        if (! is_string($locale) || ! in_array($locale, $allowedLocales, true)) {
+            $locale = 'en';
+        }
+
+        App::setLocale($locale === 'zh' ? 'zh_CN' : $locale);
 
         return $next($request);
     }
