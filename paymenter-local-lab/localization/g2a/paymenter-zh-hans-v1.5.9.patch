diff --git a/app/Admin/Concerns/LocalizesAdminResource.php b/app/Admin/Concerns/LocalizesAdminResource.php
new file mode 100755
--- /dev/null
+++ b/app/Admin/Concerns/LocalizesAdminResource.php
@@ -0,0 +1,34 @@
+<?php
+
+namespace App\Admin\Concerns;
+
+use Illuminate\Support\Str;
+
+trait LocalizesAdminResource
+{
+    use LocalizesNavigation;
+
+    private static function translateModelLabel(string $label): string
+    {
+        $key = 'model:' . Str::snake(Str::lower($label));
+        $translation = __($key);
+
+        if (is_string($translation) && $translation !== $key) {
+            return $translation;
+        }
+
+        $fallback = __(Str::title($label));
+
+        return is_string($fallback) ? $fallback : $label;
+    }
+
+    public static function getModelLabel(): string
+    {
+        return static::translateModelLabel(parent::getModelLabel());
+    }
+
+    public static function getPluralModelLabel(): string
+    {
+        return static::translateModelLabel(parent::getPluralModelLabel());
+    }
+}
