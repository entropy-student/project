  "id": 858,
  "content": "<!-- wp:group {\"className\":\"bms-hero\"} -->\n<div class=\"wp-block-group bms-hero\"><!-- wp:image {\"id\":1137,\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"className\":\"bms-focus-background\"} -->\n<figure class=\"wp-block-image size-full bms-focus-background\"><img src=\"http://127.0.0.1:8189/wp-content/uploads/2026/10/g3cr6-gift-hero.png\" alt=\"Fictional Mira birthday magazine and open spread, styled as a gift\" class=\"wp-image-1137\" /></figure>\n<!-- /wp:image -->\n<!-- wp:group {\"className\":\"bms-focus-frame\"} -->\n<div class=\"wp-block-group bms-focus-frame\"><!-- wp:image {\"id\":1137,\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"className\":\"bms-focus-sharp\"} -->\n<figure class=\"wp-block-image size-full bms-focus-sharp\"><img src=\"http://127.0.0.1:8189/wp-content/uploads/2026/10/g3cr6-gift-hero.png\" alt=\"A personalized magazine, made about one person\" class=\"wp-image-1137\" /></figure>\n<!-- /wp:image -->\n<!-- wp:paragraph {\"className\":\"bms-focus-tag\"} -->\n<p class=\"bms-focus-tag\">Their story. In focus.</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\":\"bms-hero-message\"} -->\n<div class=\"wp-block-group bms-hero-message\"><!-- wp:heading {\"level\":1,\"className\":\"bms-heading\"} -->\n<h1 class=\"wp-block-heading bms-heading\">A birthday magazine.<br><em>Made about them.</em></h1>\n<!-- /wp:heading -->\n<!-- wp:paragraph {\"className\":\"bms-copy\"} -->\n<p class=\"bms-copy\">Their photos. Their stories. A gift only you could give.</p>\n<!-- /wp:paragraph -->\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"bms-focus-link\"} -->\n<div class=\"wp-block-button bms-focus-link\"><a class=\"wp-block-button__link wp-element-button\" href=\"#preview\">Create a free preview</a></div>\n<!-- /wp:button -->\n</div>\n<!-- /wp:buttons -->\n<!-- wp:paragraph {\"className\":\"bms-focus-note\"} -->\n<p class=\"bms-focus-note\">Browser-local preview · No design skills needed</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n<!-- wp:paragraph {\"className\":\"bms-hero-caption\"} -->\n<p class=\"bms-hero-caption\">Fictional sample magazine · 12-page digital PDF</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\":\"bms-included bms-focus-split\",\"anchor\":\"what-you-get\"} -->\n<div id=\"what-you-get\" class=\"wp-block-group bms-included bms-focus-split\"><!-- wp:image {\"id\":1138,\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"className\":\"bms-focus-visual\"} -->\n<figure class=\"wp-block-image size-full bms-focus-visual\"><img src=\"http://127.0.0.1:8189/wp-content/uploads/2026/10/g3cr6-sample-spread.png\" alt=\"An illustrative story spread with fictional photos\" class=\"wp-image-1138\" /></figure>\n<!-- /wp:image -->\n<!-- wp:group {\"className\":\"bms-focus-copy\"} -->\n<div class=\"wp-block-group bms-focus-copy\"><!-- wp:heading {\"level\":2,\"className\":\"bms-heading\"} -->\n<h2 class=\"wp-block-heading bms-heading\">Your person.<br><em>Our pages.</em></h2>\n<!-- /wp:heading -->\n<!-- wp:paragraph {\"className\":\"bms-copy\"} -->\n<p class=\"bms-copy\">Turn the photos and stories you know by heart into a personalized 12-page birthday magazine. A cover, a life in photographs, and the little things that make them who they are.</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"bms-copy\"} -->\n<p class=\"bms-copy\">A digital keepsake in US Letter PDF format. Story-driven layouts, your photographs, and one bounded revision batch. No printing or shipping.</p>\n<!-- /wp:paragraph -->\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"bms-focus-link\"} -->\n<div class=\"wp-block-button bms-focus-link\"><a class=\"wp-block-button__link wp-element-button\" href=\"#samples\">Look inside</a></div>\n<!-- /wp:button -->\n</div>\n<!-- /wp:buttons -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\":\"bms-preview-chapter\",\"anchor\":\"preview\"} -->\n<div id=\"preview\" class=\"wp-block-group bms-preview-chapter\"><!-- wp:group {\"className\":\"bms-focus-photo-panel\"} -->\n<div class=\"wp-block-group bms-focus-photo-panel\"><!-- wp:image {\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"className\":\"bms-panel-background\"} -->\n<figure class=\"wp-block-image size-full bms-panel-background\"><img src=\"http://127.0.0.1:8189/wp-content/plugins/bms-g3c-preview/assets/g3cr6r3d2r2/preview-memories-panel.png\" alt=\"Two fictional friends sharing printed memories; original illustrative photograph\" /></figure>\n<!-- /wp:image -->\n<!-- wp:group {\"className\":\"bms-dark-panel\"} -->\n<div class=\"wp-block-group bms-dark-panel\"><!-- wp:heading {\"level\":2,\"className\":\"bms-heading\"} -->\n<h2 class=\"wp-block-heading bms-heading\">The first little<br><em>wow.</em></h2>\n<!-- /wp:heading -->\n<!-- wp:paragraph {\"className\":\"bms-copy\"} -->\n<p class=\"bms-copy\">Choose one photo. Add their name. See a cover and sample spread come to life — right here, for free.</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"bms-panel-note\"} -->\n<p class=\"bms-panel-note\">Your photo stays in this browser. Nothing is uploaded.</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\":\"bms-preview-surface\"} -->\n<div class=\"wp-block-group bms-preview-surface\"><!-- wp:shortcode -->\n[bms_preview product_id=\"1113\"]\n<!-- /wp:shortcode -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\":\"bms-how bms-focus-split\",\"anchor\":\"how-it-works\"} -->\n<div id=\"how-it-works\" class=\"wp-block-group bms-how bms-focus-split\"><!-- wp:image {\"id\":1139,\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"className\":\"bms-focus-visual bms-contained-cover\"} -->\n<figure class=\"wp-block-image size-full bms-focus-visual bms-contained-cover\"><img src=\"http://127.0.0.1:8189/wp-content/uploads/2026/10/g3cr6-sample-cover.png\" alt=\"Fictional Alex magazine cover\" class=\"wp-image-1139\" /></figure>\n<!-- /wp:image -->\n<!-- wp:group {\"className\":\"bms-focus-copy\"} -->\n<div class=\"wp-block-group bms-focus-copy\"><!-- wp:heading {\"level\":2,\"className\":\"bms-heading\"} -->\n<h2 class=\"wp-block-heading bms-heading\">You bring<br><em>the person.</em></h2>\n<!-- /wp:heading -->\n<!-- wp:paragraph {\"className\":\"bms-copy\"} -->\n<p class=\"bms-copy\">We bring the pages. No blank canvas, no design software. A thoughtful way to tell their story.</p>\n<!-- /wp:paragraph -->\n<!-- wp:group {\"className\":\"bms-focus-steps\"} -->\n<div class=\"wp-block-group bms-focus-steps\"><!-- wp:paragraph {\"className\":\"bms-copy\"} -->\n<p class=\"bms-copy\"><strong>Choose photos + answer prompts</strong><br>Start with the people, moments and little details you know best.</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"bms-copy\"} -->\n<p class=\"bms-copy\"><strong>Create a free preview</strong><br>Try an illustrative cover and sample spread before purchase.</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"bms-copy\"} -->\n<p class=\"bms-copy\"><strong>Purchase through WooCommerce</strong><br>The complete 12-page digital magazine is US$39.99.</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"bms-copy\"} -->\n<p class=\"bms-copy\"><strong>Continue in your private workspace</strong><br>Sign in after purchase to continue with your order.</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\":\"bms-offer bms-focus-photo-panel bms-panel-right\",\"anchor\":\"offer\"} -->\n<div id=\"offer\" class=\"wp-block-group bms-offer bms-focus-photo-panel bms-panel-right\"><!-- wp:image {\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"className\":\"bms-panel-background\"} -->\n<figure class=\"wp-block-image size-full bms-panel-background\"><img src=\"http://127.0.0.1:8189/wp-content/plugins/bms-g3c-preview/assets/g3cr6r3d2r2/offer-birthday-panel.png\" alt=\"Fictional father and daughter celebrating a birthday; original illustrative photograph\" /></figure>\n<!-- /wp:image -->\n<!-- wp:group {\"className\":\"bms-dark-panel\"} -->\n<div class=\"wp-block-group bms-dark-panel\"><!-- wp:heading {\"level\":2,\"className\":\"bms-heading\"} -->\n<h2 class=\"wp-block-heading bms-heading\">Give them<br><em>their own issue.</em></h2>\n<!-- /wp:heading -->\n<!-- wp:paragraph {\"className\":\"bms-copy\"} -->\n<p class=\"bms-copy\">One person. One very good story. A personalized 12-page digital birthday magazine.</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"bms-focus-price\"} -->\n<p class=\"bms-focus-price\">US$39.99</p>\n<!-- /wp:paragraph -->\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"bms-focus-link\"} -->\n<div class=\"wp-block-button bms-focus-link\"><a class=\"wp-block-button__link wp-element-button\" href=\"http://127.0.0.1:8189/product/birthday-magazine/\">Make their birthday magazine</a></div>\n<!-- /wp:button -->\n</div>\n<!-- /wp:buttons -->\n<!-- wp:paragraph {\"className\":\"bms-panel-note\"} -->\n<p class=\"bms-panel-note\">Digital PDF only. Continue in a private account workspace after purchase.</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\":\"bms-faq\",\"anchor\":\"faq\"} -->\n<div id=\"faq\" class=\"wp-block-group bms-faq\"><!-- wp:heading {\"level\":2,\"className\":\"bms-heading\"} -->\n<h2 class=\"wp-block-heading bms-heading\">A few good<br><em>questions.</em></h2>\n<!-- /wp:heading -->\n<!-- wp:group {\"className\":\"bms-focus-faq-grid\"} -->\n<div class=\"wp-block-group bms-focus-faq-grid\"><!-- wp:group {\"className\":\"bms-focus-question\"} -->\n<div class=\"wp-block-group bms-focus-question\"><!-- wp:heading {\"level\":3,\"className\":\"bms-heading\"} -->\n<h3 class=\"wp-block-heading bms-heading\">What will I receive?</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph {\"className\":\"bms-copy\"} -->\n<p class=\"bms-copy\">A personalized 12-page US Letter digital PDF. The free preview is illustrative, not the finished magazine.</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\":\"bms-focus-question\"} -->\n<div class=\"wp-block-group bms-focus-question\"><!-- wp:heading {\"level\":3,\"className\":\"bms-heading\"} -->\n<h3 class=\"wp-block-heading bms-heading\">Do I need design experience?</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph {\"className\":\"bms-copy\"} -->\n<p class=\"bms-copy\">No. Choose photos and answer the story prompts. You do not need to design the pages yourself.</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\":\"bms-focus-question\"} -->\n<div class=\"wp-block-group bms-focus-question\"><!-- wp:heading {\"level\":3,\"className\":\"bms-heading\"} -->\n<h3 class=\"wp-block-heading bms-heading\">Does the free preview upload my photo?</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph {\"className\":\"bms-copy\"} -->\n<p class=\"bms-copy\">No. The selected preview photo stays browser-local. It is not sent to WordPress or an external image service.</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\":\"bms-focus-question\"} -->\n<div class=\"wp-block-group bms-focus-question\"><!-- wp:heading {\"level\":3,\"className\":\"bms-heading\"} -->\n<h3 class=\"wp-block-heading bms-heading\">Why do I need an account?</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph {\"className\":\"bms-copy\"} -->\n<p class=\"bms-copy\">Your authenticated account gives you access to your private order workspace.</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\":\"bms-focus-question\"} -->\n<div class=\"wp-block-group bms-focus-question\"><!-- wp:heading {\"level\":3,\"className\":\"bms-heading\"} -->\n<h3 class=\"wp-block-heading bms-heading\">Can I request changes?</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph {\"className\":\"bms-copy\"} -->\n<p class=\"bms-copy\">The product includes one bounded revision batch.</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\":\"bms-focus-question\"} -->\n<div class=\"wp-block-group bms-focus-question\"><!-- wp:heading {\"level\":3,\"className\":\"bms-heading\"} -->\n<h3 class=\"wp-block-heading bms-heading\">How long are files kept?</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph {\"className\":\"bms-copy\"} -->\n<p class=\"bms-copy\">Source and intermediate assets are deleted within 24 hours after final delivery or approval. The final PDF is retained for 72 hours.</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\":\"bms-samples\",\"anchor\":\"samples\"} -->\n<div id=\"samples\" class=\"wp-block-group bms-samples\"><!-- wp:heading {\"level\":2,\"className\":\"bms-heading\"} -->\n<h2 class=\"wp-block-heading bms-heading\">Magazine<br><em>moments.</em></h2>\n<!-- /wp:heading -->\n<!-- wp:paragraph {\"className\":\"bms-copy\"} -->\n<p class=\"bms-copy\">A little look inside. Fictional samples, shown for illustration.</p>\n<!-- /wp:paragraph -->\n<!-- wp:group {\"className\":\"bms-focus-card\"} -->\n<div class=\"wp-block-group bms-focus-card\"><!-- wp:image {\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"className\":\"bms-card-cover\"} -->\n<figure class=\"wp-block-image size-full bms-card-cover\"><img src=\"http://127.0.0.1:8189/wp-content/plugins/bms-g3c-preview/assets/g3cr6r3d2r2/sample-eli-cover.png\" alt=\"Fictional Eli birthday cover on a terracotta table; illustrative static sample\" /></figure>\n<!-- /wp:image -->\n<!-- wp:paragraph {\"className\":\"bms-card-label\"} -->\n<p class=\"bms-card-label\">The cover</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\":\"bms-focus-card\"} -->\n<div class=\"wp-block-group bms-focus-card\"><!-- wp:image {\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"className\":\"\"} -->\n<figure class=\"wp-block-image size-full \"><img src=\"http://127.0.0.1:8189/wp-content/plugins/bms-g3c-preview/assets/g3cr6r3d2r2/sample-moments-spread.png\" alt=\"Fictional photo-story spread on a blue and yellow surface; illustrative static sample\" /></figure>\n<!-- /wp:image -->\n<!-- wp:paragraph {\"className\":\"bms-card-label\"} -->\n<p class=\"bms-card-label\">The story</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\":\"bms-focus-card\"} -->\n<div class=\"wp-block-group bms-focus-card\"><!-- wp:image {\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"className\":\"\"} -->\n<figure class=\"wp-block-image size-full \"><img src=\"http://127.0.0.1:8189/wp-content/plugins/bms-g3c-preview/assets/g3cr6r3d2r2/sample-lena-gift.png\" alt=\"Fictional Lena receiving a birthday magazine; illustrative static sample\" /></figure>\n<!-- /wp:image -->\n<!-- wp:paragraph {\"className\":\"bms-card-label\"} -->\n<p class=\"bms-card-label\">The gift</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\":\"bms-value-strip bms-closing\"} -->\n<div class=\"wp-block-group bms-value-strip bms-closing\"><!-- wp:image {\"id\":1139,\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"className\":\"bms-closing-photo bms-closing-photo-left\"} -->\n<figure class=\"wp-block-image size-full bms-closing-photo bms-closing-photo-left\"><img src=\"http://127.0.0.1:8189/wp-content/uploads/2026/10/g3cr6-sample-cover.png\" alt=\"Fictional magazine cover\" class=\"wp-image-1139\" /></figure>\n<!-- /wp:image -->\n<!-- wp:group {\"className\":\"bms-closing-copy\"} -->\n<div class=\"wp-block-group bms-closing-copy\"><!-- wp:heading {\"level\":2,\"className\":\"bms-heading\"} -->\n<h2 class=\"wp-block-heading bms-heading\">Make their next<br><em>chapter a good one.</em></h2>\n<!-- /wp:heading -->\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"bms-focus-link\"} -->\n<div class=\"wp-block-button bms-focus-link\"><a class=\"wp-block-button__link wp-element-button\" href=\"#preview\">Create a free preview</a></div>\n<!-- /wp:button -->\n</div>\n<!-- /wp:buttons -->\n<!-- wp:paragraph {\"className\":\"bms-copy\"} -->\n<p class=\"bms-copy\">A personalized magazine. A birthday worth remembering.</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n<!-- wp:image {\"id\":1138,\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"className\":\"bms-closing-photo bms-closing-photo-right\"} -->\n<figure class=\"wp-block-image size-full bms-closing-photo bms-closing-photo-right\"><img src=\"http://127.0.0.1:8189/wp-content/uploads/2026/10/g3cr6-sample-spread.png\" alt=\"Fictional story spread\" class=\"wp-image-1138\" /></figure>\n<!-- /wp:image -->\n</div>\n<!-- /wp:group -->\n"
}
