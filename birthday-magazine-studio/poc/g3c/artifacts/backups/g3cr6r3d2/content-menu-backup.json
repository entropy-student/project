{
    "home": {
        "id": 858,
        "content": "<!-- wp:group {\"className\":\"bms-hero\"} -->\n<div class=\"wp-block-group bms-hero\"><!-- wp:paragraph {\"className\":\"bms-eyebrow\"} -->\n<p class=\"bms-eyebrow\">FOR THEIR NEXT CHAPTER</p>\n<!-- /wp:paragraph -->\n<!-- wp:heading {\"level\":1} -->\n<h1 class=\"wp-block-heading\">A birthday gift,<br>all about them.</h1>\n<!-- /wp:heading -->\n<!-- wp:paragraph {\"className\":\"bms-hero-copy\"} -->\n<p class=\"bms-hero-copy\">Turn the photos, stories and little things you love into their very own personalized birthday magazine.</p>\n<!-- /wp:paragraph -->\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button -->\n<div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"#preview\">See their free preview &rarr;</a></div>\n<!-- /wp:button -->\n</div>\n<!-- /wp:buttons -->\n<!-- wp:paragraph {\"className\":\"bms-fine\"} -->\n<p class=\"bms-fine\">Made for one very special person. No design skills needed.</p>\n<!-- /wp:paragraph -->\n<!-- wp:group {\"className\":\"bms-hero-scene\"} -->\n<div class=\"wp-block-group bms-hero-scene\"><!-- wp:image {\"id\":1137,\"sizeSlug\":\"full\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-full\"><img src=\"http://127.0.0.1:8189/wp-content/uploads/2026/10/g3cr6-gift-hero.png\" alt=\"Personalized Mira birthday magazine in a warm gift scene\" class=\"wp-image-1137\" /></figure>\n<!-- /wp:image -->\n<!-- wp:paragraph {\"className\":\"bms-gift-note\"} -->\n<p class=\"bms-gift-note\">12 pages.<br>One very special person.</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\":\"bms-value-strip\"} -->\n<div class=\"wp-block-group bms-value-strip\"><!-- wp:paragraph -->\n<p>A PERSONALIZED BIRTHDAY GIFT &nbsp; / &nbsp; 12-PAGE DIGITAL PDF &nbsp; / &nbsp; FREE PREVIEW, NO UPLOAD</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\":\"bms-samples\",\"anchor\":\"samples\"} -->\n<div id=\"samples\" class=\"wp-block-group bms-samples\"><!-- wp:group {\"className\":\"bms-section-inner\"} -->\n<div class=\"wp-block-group bms-section-inner\"><!-- wp:paragraph {\"className\":\"bms-eyebrow\"} -->\n<p class=\"bms-eyebrow\">A LITTLE LOOK INSIDE</p>\n<!-- /wp:paragraph -->\n<!-- wp:heading {\"level\":2} -->\n<h2 class=\"wp-block-heading\">Not just a message.<br>A whole magazine.</h2>\n<!-- /wp:heading -->\n<!-- wp:paragraph {\"className\":\"bms-section-copy\"} -->\n<p class=\"bms-section-copy\">A cover worth keeping. A story only you could tell. Picture their birthday, in print-inspired pages.</p>\n<!-- /wp:paragraph -->\n<!-- wp:group {\"className\":\"bms-gallery\"} -->\n<div class=\"wp-block-group bms-gallery\"><!-- wp:group {\"className\":\"bms-gallery-spread\"} -->\n<div class=\"wp-block-group bms-gallery-spread\"><!-- wp:image {\"id\":1138,\"sizeSlug\":\"full\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-full\"><img src=\"http://127.0.0.1:8189/wp-content/uploads/2026/10/g3cr6-sample-spread.png\" alt=\"Birthday magazine editorial spread with friends and travel photographs\" class=\"wp-image-1138\" /></figure>\n<!-- /wp:image -->\n<!-- wp:paragraph -->\n<p>The moments that make a life. &mdash; Fictional sample spread</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\":\"bms-gallery-cover\"} -->\n<div class=\"wp-block-group bms-gallery-cover\"><!-- wp:image {\"id\":1139,\"sizeSlug\":\"full\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-full\"><img src=\"http://127.0.0.1:8189/wp-content/uploads/2026/10/g3cr6-sample-cover.png\" alt=\"Fictional Alex personalized birthday magazine cover\" class=\"wp-image-1139\" /></figure>\n<!-- /wp:image -->\n<!-- wp:paragraph -->\n<p>Their name on the cover. &mdash; Fictional sample</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\":\"bms-preview-chapter\",\"anchor\":\"preview\"} -->\n<div id=\"preview\" class=\"wp-block-group bms-preview-chapter\"><!-- wp:group {\"className\":\"bms-chapter-heading\"} -->\n<div class=\"wp-block-group bms-chapter-heading\"><!-- wp:paragraph {\"className\":\"bms-eyebrow\"} -->\n<p class=\"bms-eyebrow\">THE FIRST LITTLE WOW</p>\n<!-- /wp:paragraph -->\n<!-- wp:heading {\"level\":2} -->\n<h2 class=\"wp-block-heading\">Now, make it theirs.</h2>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p>Choose their photo. Add their name. See a cover and sample spread come to life &mdash; right here, for free.</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n<!-- wp:shortcode -->\n[bms_preview product_id=\"1113\"]\n<!-- /wp:shortcode -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\":\"bms-included\",\"anchor\":\"what-you-get\"} -->\n<div id=\"what-you-get\" class=\"wp-block-group bms-included\"><!-- wp:group {\"className\":\"bms-section-inner\"} -->\n<div class=\"wp-block-group bms-section-inner\"><!-- wp:group {\"className\":\"bms-included-grid\"} -->\n<div class=\"wp-block-group bms-included-grid\"><!-- wp:group {\"className\":\"bms-included-visual\"} -->\n<div class=\"wp-block-group bms-included-visual\"><!-- wp:paragraph {\"className\":\"bms-eyebrow\"} -->\n<p class=\"bms-eyebrow\">THE COMPLETE ISSUE</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"bms-big-number\"} -->\n<p class=\"bms-big-number\">12</p>\n<!-- /wp:paragraph -->\n<!-- wp:heading {\"level\":2} -->\n<h2 class=\"wp-block-heading\">Pages of<br>birthday goodness.</h2>\n<!-- /wp:heading -->\n<!-- wp:image {\"id\":1138,\"sizeSlug\":\"full\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-full\"><img src=\"http://127.0.0.1:8189/wp-content/uploads/2026/10/g3cr6-sample-spread.png\" alt=\"Example of the magazine pages included in the digital gift\" class=\"wp-image-1138\" /></figure>\n<!-- /wp:image -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\":\"bms-included-list\"} -->\n<div class=\"wp-block-group bms-included-list\"><!-- wp:group {\"className\":\"bms-included-feature\"} -->\n<div class=\"wp-block-group bms-included-feature\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Their own cover story</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p>A personalized cover built around the person you are celebrating.</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\":\"bms-included-feature\"} -->\n<div class=\"wp-block-group bms-included-feature\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">A life in little moments</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p>Photos, memories and the stories you bring to the private workspace.</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\":\"bms-included-feature\"} -->\n<div class=\"wp-block-group bms-included-feature\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">An editorial finish</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p>A considered magazine layout, delivered as a 12-page digital PDF.</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\":\"bms-included-feature\"} -->\n<div class=\"wp-block-group bms-included-feature\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">A digital keepsake</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p>US Letter format. Keep the file or print it yourself; printing and shipping are not included.</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\":\"bms-how\",\"anchor\":\"how-it-works\"} -->\n<div id=\"how-it-works\" class=\"wp-block-group bms-how\"><!-- wp:group {\"className\":\"bms-section-inner\"} -->\n<div class=\"wp-block-group bms-section-inner\"><!-- wp:group {\"className\":\"bms-how-grid\"} -->\n<div class=\"wp-block-group bms-how-grid\"><!-- wp:group {\"className\":\"bms-how-intro\"} -->\n<div class=\"wp-block-group bms-how-intro\"><!-- wp:paragraph {\"className\":\"bms-eyebrow\"} -->\n<p class=\"bms-eyebrow\">FROM A PHOTO TO A GIFT</p>\n<!-- /wp:paragraph -->\n<!-- wp:heading {\"level\":2} -->\n<h2 class=\"wp-block-heading\">You bring<br>the person.<br>We bring<br>the pages.</h2>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p>No blank canvas. No design software. Just a thoughtful way to celebrate someone.</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\":\"bms-journey\"} -->\n<div class=\"wp-block-group bms-journey\"><!-- wp:group {\"className\":\"bms-journey-step\"} -->\n<div class=\"wp-block-group bms-journey-step\"><!-- wp:paragraph {\"className\":\"bms-step-number\"} -->\n<p class=\"bms-step-number\">01</p>\n<!-- /wp:paragraph -->\n<!-- wp:group {\"className\":\"bms-step-copy\"} -->\n<div class=\"wp-block-group bms-step-copy\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Pick a photo you love.</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p>Start with their face, their name and a birthday. A little inspiration goes a long way.</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\":\"bms-journey-step\"} -->\n<div class=\"wp-block-group bms-journey-step\"><!-- wp:paragraph {\"className\":\"bms-step-number\"} -->\n<p class=\"bms-step-number\">02</p>\n<!-- /wp:paragraph -->\n<!-- wp:group {\"className\":\"bms-step-copy\"} -->\n<div class=\"wp-block-group bms-step-copy\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Try the free preview.</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p>See an illustrative cover and spread. Your photo stays in this browser.</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\":\"bms-journey-step\"} -->\n<div class=\"wp-block-group bms-journey-step\"><!-- wp:paragraph {\"className\":\"bms-step-number\"} -->\n<p class=\"bms-step-number\">03</p>\n<!-- /wp:paragraph -->\n<!-- wp:group {\"className\":\"bms-step-copy\"} -->\n<div class=\"wp-block-group bms-step-copy\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Make it a complete gift.</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p>Purchase the 12-page digital magazine for US$39.99 through our secure WooCommerce checkout.</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\":\"bms-journey-step\"} -->\n<div class=\"wp-block-group bms-journey-step\"><!-- wp:paragraph {\"className\":\"bms-step-number\"} -->\n<p class=\"bms-step-number\">04</p>\n<!-- /wp:paragraph -->\n<!-- wp:group {\"className\":\"bms-step-copy\"} -->\n<div class=\"wp-block-group bms-step-copy\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Continue in your private workspace.</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p>After purchase, add the photos and details for the complete magazine in your own workspace.</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\":\"bms-offer\",\"anchor\":\"offer\"} -->\n<div id=\"offer\" class=\"wp-block-group bms-offer\"><!-- wp:group {\"className\":\"bms-section-inner\"} -->\n<div class=\"wp-block-group bms-section-inner\"><!-- wp:paragraph {\"className\":\"bms-eyebrow\"} -->\n<p class=\"bms-eyebrow\">A BIRTHDAY ONLY THEY COULD HAVE</p>\n<!-- /wp:paragraph -->\n<!-- wp:heading {\"level\":2} -->\n<h2 class=\"wp-block-heading\">Give them<br>their own good issue.</h2>\n<!-- /wp:heading -->\n<!-- wp:paragraph {\"className\":\"bms-offer-copy\"} -->\n<p class=\"bms-offer-copy\">Because the best gifts say: I see you. I know you. And there is so much to celebrate.</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"bms-price\"} -->\n<p class=\"bms-price\">US$39.99</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"bms-fine\"} -->\n<p class=\"bms-fine\">The complete 12-page digital PDF</p>\n<!-- /wp:paragraph -->\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button -->\n<div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"http://127.0.0.1:8189/product/birthday-magazine/\">Make their birthday magazine &rarr;</a></div>\n<!-- /wp:button -->\n</div>\n<!-- /wp:buttons -->\n<!-- wp:paragraph {\"className\":\"bms-fine\"} -->\n<p class=\"bms-fine\">Digital product only. Printing and shipping are not included.<br>Continue with your details in a private workspace after purchase.</p>\n<!-- /wp:paragraph -->\n<!-- wp:image {\"id\":1139,\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"className\":\"bms-offer-cover\"} -->\n<figure class=\"wp-block-image size-full bms-offer-cover\"><img src=\"http://127.0.0.1:8189/wp-content/uploads/2026/10/g3cr6-sample-cover.png\" alt=\"Alex birthday magazine sample\" class=\"wp-image-1139\" /></figure>\n<!-- /wp:image -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\":\"bms-faq\",\"anchor\":\"faq\"} -->\n<div id=\"faq\" class=\"wp-block-group bms-faq\"><!-- wp:group {\"className\":\"bms-section-inner\"} -->\n<div class=\"wp-block-group bms-section-inner\"><!-- wp:group {\"className\":\"bms-faq-title\"} -->\n<div class=\"wp-block-group bms-faq-title\"><!-- wp:heading {\"level\":2} -->\n<h2 class=\"wp-block-heading\">A few good questions.</h2>\n<!-- /wp:heading -->\n<!-- wp:paragraph {\"className\":\"bms-fine\"} -->\n<p class=\"bms-fine\">The details, before the big day.</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\":\"bms-faq-grid\"} -->\n<div class=\"wp-block-group bms-faq-grid\"><!-- wp:group {\"className\":\"bms-question\"} -->\n<div class=\"wp-block-group bms-question\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Is this a printed magazine?</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p>Your purchase is a 12-page digital PDF in US Letter format. We do not print or ship a physical magazine. You can choose to print the PDF yourself.</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\":\"bms-question\"} -->\n<div class=\"wp-block-group bms-question\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">What do I get in the free preview?</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p>An illustrative cover and sample spread using your browser-local photo and details. It is not the complete magazine or a final PDF.</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\":\"bms-question\"} -->\n<div class=\"wp-block-group bms-question\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">What happens after purchase?</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p>Native WooCommerce checkout records your purchase. Continue adding your information in the private workspace linked to your account.</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\":\"bms-question\"} -->\n<div class=\"wp-block-group bms-question\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Where does my preview photo go?</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p>Nowhere. The free preview uses a temporary browser-local object URL. It does not upload your photo or send it to an AI model.</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\":\"bms-question\"} -->\n<div class=\"wp-block-group bms-question\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Can I make it for someone else?</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p>Yes. This is a gift for a specific person: a partner, a friend, a parent, or someone you want to celebrate.</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\":\"bms-question\"} -->\n<div class=\"wp-block-group bms-question\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">What should I have ready?</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p>A photo, their name and a birthday to start. For the complete magazine, bring the photos and personal details you want to include.</p>\n<!-- /wp:paragraph -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n",
