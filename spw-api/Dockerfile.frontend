FROM oven/bun:1.4.0@sha256:5ff609364c049b54eb0ff560ec96319729a972078ef2c755d758f0c6ef89c2d6 AS build
WORKDIR /build/web
COPY source/web/package.json source/web/bun.lock ./
RUN bun install --frozen-lockfile
COPY source/web/ ./
ENV VITE_REACT_APP_VERSION=v1.0.0-rc.46-spw-glacier
RUN bun run build

FROM nginx:stable-alpine@sha256:47928bf67eb62a1863cb08d9ecb52d3e704304ba614eaee17884204677702951
COPY --from=build /build/web/dist /usr/share/nginx/html
COPY source/LICENSE source/NOTICE source/THIRD-PARTY-LICENSES.md /usr/share/nginx/html/licenses/
COPY nginx-spw.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
